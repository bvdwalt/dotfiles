{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Downloads and installs the flux CLI for the current user.
# No Fedora rpm/COPR or Arch package covers this machine's arch, so we pull
# the binary release directly from GitHub.
# Uses run_once so it only runs a single time (tracked by chezmoi state).
# Update the version below to re-trigger the install on next `chezmoi apply`.
# FLUX_VERSION: v2.9.5

set -euo pipefail

FLUX_VERSION="2.9.5"
BIN_DIR="$HOME/.local/bin"
ARCH="{{ .chezmoi.arch }}"

if command -v flux &>/dev/null; then
  echo "flux already installed, skipping"
  exit 0
fi

if ! command -v curl &>/dev/null; then
  echo "curl not found; cannot download flux" >&2
  exit 1
fi

echo "Installing flux ${FLUX_VERSION}"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

TARBALL="flux_${FLUX_VERSION}_linux_${ARCH}.tar.gz"
BASE_URL="https://github.com/fluxcd/flux2/releases/download/v${FLUX_VERSION}"

curl -fsSL "${BASE_URL}/${TARBALL}" -o "$tmp/${TARBALL}"
curl -fsSL "${BASE_URL}/flux_${FLUX_VERSION}_checksums.txt" -o "$tmp/checksums.txt"

(cd "$tmp" && grep " ${TARBALL}\$" checksums.txt | sha256sum -c -)

tar -xzf "$tmp/${TARBALL}" -C "$tmp" flux

mkdir -p "$BIN_DIR"
install -m 0755 "$tmp/flux" "$BIN_DIR/flux"

echo "flux installed to $BIN_DIR/flux"
{{ end -}}
