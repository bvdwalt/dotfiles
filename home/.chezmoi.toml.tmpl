{{- /* Plain Arch and Fedora have no ID_LIKE, and derivatives may list several IDs */ -}}
{{- $osRelease := dict -}}
{{- if hasKey .chezmoi "osRelease" -}}
{{-   $osRelease = .chezmoi.osRelease -}}
{{- end -}}
{{- $osIds := splitList " " (printf "%s %s" (get $osRelease "id") (get $osRelease "idLike")) -}}
{{- $isWork := promptBoolOnce . "isWork" "Is this a work machine" -}}
progress = true
[git]
    autoCommit = false
    autoPush = false

[diff]
    pager = "delta"

[merge]
    command = "nvim"
    args = ["-d", {{ printf "%q" "{{ .Destination }}" }}, {{ printf "%q" "{{ .Source }}" }}, {{ printf "%q" "{{ .Target }}" }}]

[data]
    isArch = {{ has "arch" $osIds }}
    isFedora = {{ has "fedora" $osIds }}
    isWork = {{ $isWork }}
