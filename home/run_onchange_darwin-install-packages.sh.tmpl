{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

echo "==> brew: installing taps and casks"
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

# brew only upgrades what it owns, brw owns the core formulae
echo "==> brew: upgrading taps and casks"
brew upgrade --formula{{ range .packages.darwin.brews }} {{ . | quote }}{{ end }}
brew upgrade --cask

echo "==> brw: managing core formulae"
if command -v brw >/dev/null 2>&1; then
  brw update
  brw upgrade
  brw install{{ range .packages.darwin.brw }} {{ . | quote }}{{ end }}
else
  echo "brw not found, skipping brw-managed formulae" >&2
fi
{{ end -}}
