{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# /etc/xdg/plasma-workspace/env/ssh-agent.sh only sets SSH_AUTH_SOCK when
# empty, then Plasma imports that into systemd --user, overwriting any value
# environment.d already set. Since this file sorts after ssh-agent.sh, it
# reasserts 1Password's SSH agent socket unconditionally.
if [ -S "$HOME/.1password/agent.sock" ]; then
    export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
fi
{{ end -}}
