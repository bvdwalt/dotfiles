{{ if and (eq .chezmoi.os "linux") (eq (env "XDG_CURRENT_DESKTOP") "KDE") -}}
#!/bin/bash
# Applies KDE Plasma settings via kwriteconfig6.
# This script is re-run by chezmoi whenever its content changes.

set -euo pipefail

if ! command -v kwriteconfig6 &>/dev/null; then
  echo "kwriteconfig6 not found, skipping KDE settings"
  exit 0
fi

echo "Applying KDE settings"

# --- Keybindings ---
# Add Super+Return as an alternate maximize toggle (stays a normal window:
# panel visible, can still be un-maximized or tiled left/right), rather than
# true fullscreen which hides the panel entirely.
kwriteconfig6 --file kglobalshortcutsrc --group kwin --key "Window Maximize" "Meta+Return,none,Maximize Window"

# Note: kglobalaccel (built into kwin_wayland on Plasma 6) only reads
# kglobalshortcutsrc at startup, so this shortcut takes effect after the
# next login rather than immediately.

echo "KDE settings applied"
{{ end -}}
