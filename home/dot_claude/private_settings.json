{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "tui": "fullscreen",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "autoContinueAtUsageLimit": true,
  "switchModelsOnFlag": true,
  "permissions": {
    "allow": [
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git worktree:*)",
      "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr diff:*)", "Bash(gh run watch *)",
      "Bash(kubectl get:*)", "Bash(kubectl describe:*)", "Bash(kubectl logs:*)",
      "Bash(flux get:*)",
      "Bash(kubectl --context altair get *)", "Bash(kubectl --context altair logs *)",
      "Bash(kubectl --context altair top *)", "Bash(kubectl --context altair describe *)",
      "Bash(flux --context altair get *)",
      "Bash(go test *)", "Bash(go build *)", "Bash(go vet *)", "Bash(gofmt -l *)",
      "Bash(golangci-lint run *)", "Bash(npx svelte-check *)", "Bash(npx vitest *)",
      "Bash(helm template *)", "Bash(helm lint *)",
      "mcp__Claude_Browser__find", "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages", "mcp__Claude_Browser__read_network_requests",
      "mcp__ccd_pr__get_status"
    ],
    "ask": [
      "Bash(git cherry-pick:*)", "Bash(git push:*)",
      "Bash(kubectl delete:*)", "Bash(kubectl patch:*)", "Bash(flux suspend:*)",
      "Bash(kubectl exec:*)", "Bash(kubectl --context altair exec *)",
      "Bash(kubectl --context altair annotate *)", "Bash(kubectl --context altair apply *)",
      "Bash(kubectl --context altair port-forward *)", "Bash(kubectl --context altair delete *)",
      "Bash(gh api:*)", "Bash(gh pr comment:*)", "Bash(gh pr review:*)", "Bash(gh pr edit:*)",
      "Bash(gh pr create:*)", "Bash(gh pr merge:*)", "Bash(gh issue comment:*)",
      "Bash(docker run:*)", "Bash(go run:*)", "Bash(just:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/no-em-dash.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/check-conventional.sh" },
          { "type": "command", "command": "~/.claude/hooks/no-gnu-timeout.sh" },
          { "type": "command", "command": "~/.claude/hooks/lint-before-push.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
