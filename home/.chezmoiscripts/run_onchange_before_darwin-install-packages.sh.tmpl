{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Install only: upgrades live in the pkgup fish function
echo "==> brew: installing taps and casks"
brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ if .isWork -}}
{{ range .packages.darwin.workCasks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF

echo "==> brw: installing core formulae"
if command -v brw >/dev/null 2>&1; then
  brw update
  brw install{{ range .packages.darwin.brw }} {{ . | quote }}{{ end }}
else
  echo "brw not found, skipping brw-managed formulae" >&2
fi
{{ end -}}
